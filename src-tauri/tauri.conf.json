{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spagitty",
  "version": "0.5.1",
  "identifier": "dev.spagitty.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Spagitty",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A cross-platform desktop Git client. Free software under GPL-3.0-or-later. Not affiliated with the Git project or the Software Freedom Conservancy.",
    "shortDescription": "Desktop Git client",
    "windows": {
      "wix": {
        "version": "0.5.1.0"
      }
    }
  }
}
