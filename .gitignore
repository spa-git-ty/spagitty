node_modules/
# ...and a bare `node_modules`, which a git worktree is often given as a
# symlink to the main checkout. The trailing slash above does not match one,
# and an absolute symlink is worthless to anyone else who clones this.
node_modules
/build
/.svelte-kit
/dist
/coverage
/src-tauri/target
/target
THIRD-PARTY-LICENSES.md
.DS_Store
*.log
run_claude_job.sh
.claude/
.idea/
__pycache__/
/.spagitty/
src-tauri/gen/schemas/windows-schema.json

# Extension build products (FEAT-096): programs and packages are made, not kept.
/examples/extensions/*/bin/
/examples/extensions/*/dist/
*.spagitty-extension

# The terminal's multiplexer is downloaded before Tauri reads its resources
# (FEAT-130): a binary for one platform, fetched and checked, never committed.
/multiplexer/bundle/*
!/multiplexer/bundle/.gitkeep
/multiplexer/.download/

# Screenshots and recordings attached in the sweep portal: kept on the machine
# that took them, linked from the results, never committed.
/agile/testing/evidence/

