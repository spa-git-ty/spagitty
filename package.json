{
  "name": "spagitty",
  "version": "4.0.1",
  "description": "Your gateway to a Git-managed agent farm \u2014 a local-first desktop Git client",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite dev",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p packages/extension-sdk --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "tauri": "tauri",
    "ext": "bun tools/extensions/cli.ts",
    "sweep": "bun tools/sweep/serve.ts",
    "sweep:index": "bun tools/sweep/index.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^21.0.4",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  }
}
